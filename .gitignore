#env
.env
.env.*
!.env.local.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*

# Rendered HTML dumps written by the state harnesses in .agent-logs/ (home-states,
# creator-pages-states, auth-states, ...). The harness .mjs sources and the
# product-audit notes are tracked; their .html output is not. Each harness run
# rewrites every dump, which is why the last commit contained nothing but these.
# The HTML files in dist/ are unaffected, so the deployed build is unchanged.
/.agent-logs/*.html
# Sample response written by .agent-logs/ai-live-check.mjs, same reasoning: the
# harness is tracked, its output is not.
/.agent-logs/ai-live-sample.json
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Server-framework output. The deploy does not run a server build: 'npm run
# build' is plain 'vite build', so .output stays empty and this is only here
# to catch it if that ever changes.
.output
.wrangler

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite
base44/.app.jsonc
