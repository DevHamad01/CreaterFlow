#env
.env
.env.*
!.env.local.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*

# Rendered HTML dumps written by the state harnesses in .agent-logs/ (home-states,
# creator-pages-states, auth-states, ...). The harness .mjs sources and the
# product-audit notes are tracked; their .html output is not. Each harness run
# rewrites every dump, which is why the last commit contained nothing but these.
# The HTML files in dist/ are unaffected, so the deployed build is unchanged.
/.agent-logs/*.html
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Nitro build output, once this app has a server. Both are regenerated by
# every build, and the deploy runs one before reading them.
.output
.wrangler

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vite
base44/.app.jsonc
