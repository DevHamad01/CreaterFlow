{
  "name": "CampaignCreator",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "creator_avatar": {
      "type": "string",
      "format": "uri"
    },
    "creator_niche": {
      "type": "string"
    },
    "creator_followers": {
      "type": "number"
    },
    "fit_score": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "accepted",
        "draft_submitted",
        "in_review",
        "revision_requested",
        "approved",
        "rejected",
        "scheduled",
        "live",
        "completed"
      ],
      "default": "invited"
    },
    "tracking_link": {
      "type": "string"
    },
    "invited_date": {
      "type": "string",
      "format": "date"
    },
    "accepted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "campaign_id",
    "creator_id",
    "status"
  ]
}