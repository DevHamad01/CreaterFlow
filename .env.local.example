# Copy to .env.local and fill in with your own values. Never commit .env.local.
#
# After filling this in, run `npm run doctor`. It checks that the Firebase and
# Gemini services are actually enabled for this project and tells you exactly
# what to click if they are not.

# ---------------------------------------------------------------------------
# Firebase — Firebase console > Project settings > Your apps > SDK setup
# ---------------------------------------------------------------------------
# This is a client-side app, so these values are inlined into the browser bundle
# by design. They are NOT secrets. Access control comes from Firestore Security
# Rules, not from hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Two console switches must be on before the app works. `npm run doctor` detects
# both and links to the exact page:
#   1. Cloud Firestore API enabled
#      https://console.developers.google.com/apis/api/firestore.googleapis.com/overview
#   2. Sign-in providers enabled (Email/Password, and Google if you use it)
#      Firebase console > Authentication > Sign-in method

# ---------------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# SECURITY: anything prefixed VITE_ ends up in the deployed JavaScript, so this
# key is readable by anyone who opens devtools and can be used to drain your
# quota. Restrict it before deploying:
#   Google Cloud console > APIs & Services > Credentials > your key > Edit
#     - Application restrictions: Websites, then add your deploy domain
#     - API restrictions: Generative Language API
# A referrer-restricted key cannot be called from another origin, which is what
# stops bulk abuse. For a genuinely secret key, proxy Gemini through a
# server-side function and keep the key out of the bundle entirely.
VITE_GEMINI_API_KEY=

# Pinned rather than tracking a "-latest" alias, so an upstream rename cannot
# silently change the response shape this app depends on. Set this to a model
# from the `npm run doctor` output. Two values to avoid:
#   gemini-pro     retired; returns HTTP 404
#   gemini-2.5-flash  closed to newly created projects
VITE_GEMINI_MODEL=gemini-3.8-flash
